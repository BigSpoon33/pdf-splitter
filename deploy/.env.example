# Copy to deploy/.env (gitignored). `docker compose` reads it from the compose file's directory.

# The secret under the daily-rotating IP hash (ADR-007). Required. Any long random string, e.g. `openssl rand -hex 32`.
PDFSPLIT_IP_SALT=

# The public hostname. Caddy issues a Let's Encrypt certificate for it, so DNS must already point here and
# ports 80/443 must be reachable from the internet. `localhost` (the default) uses Caddy's internal CA instead.
PUBLIC_HOST=localhost
PDFSPLIT_PUBLIC_URL=https://localhost

# Host ports caddy publishes; 80/443 on the VM, high ports on a laptop that already has a web server.
PDFSPLIT_HTTP_PORT=80
PDFSPLIT_HTTPS_PORT=443

# The stack's two networks, each with an IPv4 subnet and an IPv6 ULA /64. `backend` is internal (caddy + api);
# caddy's fixed addresses on it are the api's PDFSPLIT_TRUSTED_PROXY (v4 and v6 - it may connect over either).
# `edge` is where caddy publishes its ports and reaches the ACME servers. Change a subnet and the addresses in it
# together if a range is taken on the host.
PDFSPLIT_SUBNET=172.30.0.0/24
PDFSPLIT_SUBNET6=fd30:5eaf:9a13::/64
PDFSPLIT_CADDY_IP=172.30.0.10
PDFSPLIT_CADDY_IP6=fd30:5eaf:9a13::10
PDFSPLIT_EDGE_SUBNET=172.30.1.0/24
PDFSPLIT_EDGE_SUBNET6=fd30:5eaf:9a13:1::/64

# Limits (README § Configuration for the rest; these are the ones an operator tunes).
PDFSPLIT_WORKERS=2
PDFSPLIT_RATE_PER_HOUR=6
PDFSPLIT_MAX_BYTES=209715200
PDFSPLIT_TTL_HOURS=24
PDFSPLIT_MIN_FREE_GB=2
# Uploads streaming at once (503 `overloaded` beyond it) and uvicorn's open-connection ceiling.
PDFSPLIT_MAX_UPLOADS=4
PDFSPLIT_LIMIT_CONCURRENCY=64
# Of those uploads, how many one client (one IPv4 address or IPv6 /64) may hold at once; an upload must deliver
# at least MIN_UPLOAD_RATE bytes per 30 s window or it is abandoned (408); any other body (a JSON plan) is at
# most MAX_JSON_BYTES and must arrive whole within BODY_TIMEOUT seconds.
PDFSPLIT_MAX_UPLOADS_PER_CLIENT=2
PDFSPLIT_MIN_UPLOAD_RATE=32768
PDFSPLIT_MAX_JSON_BYTES=4194304
PDFSPLIT_BODY_TIMEOUT=20

# Image tag; deploy/smoke.sh uses `smoke` so its images never replace a running stack's.
PDFSPLIT_TAG=local
